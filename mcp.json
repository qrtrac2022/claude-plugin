{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "qrtrac": {
      "type": "streamable-http",
      "url": "https://mcp.qrtrac.com/mcp",
      "extensions": {
        "claude": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://mcp.qrtrac.com/authorize",
            "tokenUrl": "https://mcp.qrtrac.com/token",
            "registrationUrl": "https://mcp.qrtrac.com/register",
            "baseScopes": [
              "qr:read",
              "qr:write",
              "analytics:read"
            ]
          }
        }
      }
    }
  }
}
